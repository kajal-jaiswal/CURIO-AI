# ============================================================
# CurioAI Blog — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Supabase (Required) ---
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Site URL (Required in production) ---
# Set this to your deployed domain, e.g. https://curio-ai.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI Content Generation (Required for AI features) ---
# Gemini 2.0 Flash — FREE tier, much better quality than Groq
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# --- Automated Blog Cron Job (Required for cron endpoint security) ---
# Any random secret string, e.g. generated with: openssl rand -base64 32
# Set this same value in Vercel → Project Settings → Cron Jobs
CRON_SECRET=your-random-secret-here

# --- SEO (Optional) ---
# Google Search Console verification code (meta tag value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
